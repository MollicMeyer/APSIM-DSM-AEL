            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Shared.Utilities;",
                "using Models.Utilities;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    public class Script : Model",
                "    {",
                "    [Link] Clock Clock;",
                "    ",
                "        [Description(\"Crop\")]",
                "        public IPlant Crop { get; set; }",
                "        ",
                "        [Description(\"If the crop is still alive\\nterminate by (d-mmm)\")]",
                "        public string TerminationDate { get; set; }",
                "        ",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (Crop.IsReadyForHarvesting)",
                "            {",
                "                Crop.Harvest();",
                "                Crop.EndCrop();",
                "            }",
                "            ",
                "            if (DateUtilities.WithinDates(TerminationDate, Clock.Today, TerminationDate) && Crop.IsAlive)",
                "            {",
                "                Crop.Harvest();",
                "                Crop.EndCrop();  ",
                "            }",
                "            ",
                "            ",
                "        }",
                "    }",
                "}",
                "       "
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Wheat]"
                },
                {
                  "Key": "TerminationDate",
                  "Value": "30-Aug"
                }
              ],
              "Name": "HarvestWheat",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Soils;",
                "using System.Collections.Generic;",
                "using APSIM.Shared.Utilities;",
                "using Models.PMF;",
                "using Models.Interfaces;",
                "using Models.Core;",
                "using System;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] IClock Clock;",
                "        [Link] ISummary Summary;",
                "        ",
                "        [Description(\"Rotation Sequence (comma separated crop names)\")]",
                "        public string[] Crops { get; set; }",
                "        ",
                "        // Repeating cycle of input crops. Don't loop on this, loop on Crops",
                "        private IEnumerable<string> cropsEnum()",
                "        {",
                "            var counter = 0;",
                "            while (true)",
                "            {",
                "                yield return Crops[counter];",
                "                ++counter;",
                "                if (counter >= Crops.Length)",
                "                    counter = 0;",
                "            }",
                "        }",
                "        ",
                "        private IEnumerator<string> cropCycle;",
                "        ",
                "        [Description(\"Next crop to sow in the simple rotation.\")]",
                "        public string NextCrop",
                "        { get => cropCycle.Current; }",
                "        ",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void Init(object sender, EventArgs e)",
                "        {",
                "            // TODO: Error if Crops is empty.",
                "            cropCycle = cropsEnum().GetEnumerator();",
                "            // Set to first value.",
                "            cropCycle.MoveNext();",
                "        }",
                "",
                "        [EventSubscribe(\"PlantEnding\")]",
                "        private void OnEndCrop(object sender, EventArgs e)",
                "        {",
                "            // Currently assumes only one crop in the ground, so does not check if the  ",
                "            // harvested crop is this script's current crop.",
                "            var old = NextCrop;",
                "            cropCycle.MoveNext();",
                "            var _new = NextCrop;",
                "            Summary.WriteMessage(this, $\"Rotation finished with {old}, next up: {_new}.\", MessageType.Information);",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "Crops",
                  "Value": "Maize, Soybean"
                }
              ],
              "Name": "SimpleRotation",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Report, Models",
              "VariableNames": [
                "[Clock].Today as Date",
                "[Nutrient].TotalC as TotalC",
                "[Nutrient].TotalN as TotalN",
                "[Nutrient].MineralN as MineralN",
                "[Nutrient].Inert.C as InertC",
                "[Nutrient].Inert.N as InertN",
                "[Nutrient].Microbial.C as MicrobialC",
                "[Nutrient].Microbial.N as MicrobialN",
                "[Nutrient].Humic.C as HumicC",
                "[Nutrient].Humic.N as HumicN",
                "[Nutrient].FOM.C as FOMC",
                "[Nutrient].FOM.N as FOMN",
                "[Nutrient].MineralisedN as NetMineralisedN",
                "[NO3].kgha as NO3",
                "[NH4].kgha as NH4",
                "[Urea].kgha as Urea",
                "[Maize].Grain.Wt as MaizeGrain",
                "[Soybean].Grain.Wt as SoybeanGrain",
                "[Maize].Leaf.Fn as MaizeNFactor",
                "[Maize].Leaf.Fw as MaizeWaterFactor",
                "[Maize].Root.NUptake as MaizeNUptake",
                "[Maize].IsAlive as MaizeAlive",
                "[Nutrient].TotalOrganicN as OrganicN",
                "[Weather].Rain as Rain",
                "[Weather].Radn as Radn",
                "[Weather].MaxT as MaxT",
                "[Weather].MinT as MinT",
                "[Maize].LAI as MaizeLAI",
                "[SoilWater].Es as AD_Es",
                "[SoilWater].SWmm as AD_SWmm",
                "[SoilWater].Drainage as AD_Drainage",
                "[SoilWater].Runoff as AD_Runoff"
              ],
              "EventNames": [
                "[Clock].EndOfDay"
              ],
              "GroupByVariableName": null,
              "Name": "WarmupDaily",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Report, Models",
