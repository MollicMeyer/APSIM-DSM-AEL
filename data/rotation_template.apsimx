                {
                  "$type": "Models.Functions.OnEventFunction, Models",
                  "SetEvent": "HeadEmergence",
                  "ReSetEvent": "never",
                  "Name": "HeadingDAS",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
